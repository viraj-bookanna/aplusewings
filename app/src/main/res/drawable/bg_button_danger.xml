<?xml version="1.0" encoding="utf-8"?>
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="#33FF6B6B">
    <item>
        <selector>
            <item android:state_pressed="true">
                <shape android:shape="rectangle">
                    <solid android:color="#2A1414"/>
                    <corners android:radius="8dp"/>
                    <stroke android:width="1dp" android:color="@color/danger_text"/>
                </shape>
            </item>
            <item>
                <shape android:shape="rectangle">
                    <solid android:color="@color/danger_bg"/>
                    <corners android:radius="8dp"/>
                    <stroke android:width="1dp" android:color="@color/danger_stroke"/>
                </shape>
            </item>
        </selector>
    </item>
</ripple>
