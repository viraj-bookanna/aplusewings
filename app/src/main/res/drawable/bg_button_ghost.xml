<?xml version="1.0" encoding="utf-8"?>
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="#3300FF9C">
    <item>
        <selector>
            <item android:state_pressed="true">
                <shape android:shape="rectangle">
                    <solid android:color="@color/ghost_pressed_bg"/>
                    <corners android:radius="8dp"/>
                    <stroke android:width="1dp" android:color="@color/term_green"/>
                </shape>
            </item>
            <item>
                <shape android:shape="rectangle">
                    <solid android:color="@color/ghost_bg"/>
                    <corners android:radius="8dp"/>
                    <stroke android:width="1dp" android:color="@color/ghost_stroke"/>
                </shape>
            </item>
        </selector>
    </item>
</ripple>
