<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/bg_input"/>
            <corners android:radius="8dp"/>
            <stroke android:width="1dp" android:color="@color/term_green"/>
        </shape>
    </item>
    <item android:state_enabled="false">
        <shape android:shape="rectangle">
            <solid android:color="#060906"/>
            <corners android:radius="8dp"/>
            <stroke android:width="1dp" android:color="@color/text_disabled"/>
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/bg_input"/>
            <corners android:radius="8dp"/>
            <stroke android:width="1dp" android:color="@color/bg_stroke"/>
        </shape>
    </item>
</selector>
