<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_root"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- =========== HEADER =========== -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="12dp">

            <FrameLayout
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/bg_icon_tile">
                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:padding="5dp"
                    android:src="@mipmap/ic_launcher"
                    android:scaleType="centerInside" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginStart="12dp"
                android:layout_marginLeft="12dp">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/app_name"
                    android:textColor="@color/hacker_orange"
                    android:textSize="16sp"
                    android:fontFamily="monospace"
                    android:textStyle="bold"
                    android:letterSpacing="0.05" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="&gt; playback link generator"
                    android:textColor="@color/text_secondary"
                    android:textSize="11sp"
                    android:fontFamily="monospace" />
            </LinearLayout>

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/main_btn_logout"
                style="@style/DangerGhostButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:text="logout" />

            <!-- Legacy id referenced by MainActivity.findViewById -->
            <LinearLayout
                android:id="@+id/main_logout"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:visibility="gone" />
        </LinearLayout>

        <!-- =========== PLAYBACK CARD =========== -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            style="@style/Card">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    style="@style/SectionHeader"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="platform" />

                <Spinner
                    android:id="@+id/main_select_app"
                    style="@style/TerminalSpinner"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />

                <TextView
                    style="@style/SectionHeader"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="video code"
                    android:layout_marginTop="16dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <EditText
                        android:id="@+id/main_vid_code"
                        style="@style/TerminalInput"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:hint="paste code or open in app"
                        android:inputType="text"
                        android:maxLines="1" />

                    <androidx.appcompat.widget.AppCompatButton
                        android:id="@+id/main_vid_code_paste"
                        style="@style/GhostButton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:layout_marginLeft="8dp"
                        android:text="paste" />
                </LinearLayout>

                <TextView
                    style="@style/SectionHeader"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="quality"
                    android:layout_marginTop="16dp" />

                <Spinner
                    android:id="@+id/main_select_quality"
                    style="@style/TerminalSpinner"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/main_btn_generate"
                    style="@style/PrimaryButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:text="&gt; generate link" />

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- =========== OUTPUT CARD =========== -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            style="@style/Card">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="8dp">
                    <TextView
                        style="@style/SectionHeader"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginBottom="0dp"
                        android:text="output" />
                    <androidx.appcompat.widget.AppCompatButton
                        android:id="@+id/main_btn_output_copy"
                        style="@style/GhostButton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:minWidth="0dp"
                        android:minHeight="0dp"
                        android:text="copy" />
                </LinearLayout>

                <TextView
                    android:id="@+id/main_output"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="96dp"
                    android:gravity="center"
                    android:padding="14dp"
                    android:textIsSelectable="true"
                    android:textColor="@color/term_green"
                    android:textSize="12sp"
                    android:fontFamily="monospace"
                    android:background="@drawable/bg_output"
                    android:text="awaiting input..." />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- =========== PROXY CARD (collapsible) =========== -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="16dp"
            style="@style/Card">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- Header row: toggle expansion -->
                <LinearLayout
                    android:id="@+id/main_proxy_header"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:clickable="true"
                    android:focusable="true">

                    <TextView
                        style="@style/SectionHeader"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginBottom="0dp"
                        android:text="proxy (advanced)" />

                    <TextView
                        android:id="@+id/main_proxy_chevron"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="[ + ]"
                        android:textColor="@color/term_green"
                        android:fontFamily="monospace"
                        android:textSize="13sp" />
                </LinearLayout>

                <!-- Expanded body (hidden by default) -->
                <LinearLayout
                    android:id="@+id/main_proxy_body"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone"
                    android:layout_marginTop="12dp">

                    <TextView
                        style="@style/SectionHeader"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="mode" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <Spinner
                            android:id="@+id/main_select_proxy"
                            style="@style/TerminalSpinner"
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_height="wrap_content" />

                        <!-- Visibility toggled by MainActivity: shown only when mode=Local -->
                        <androidx.appcompat.widget.AppCompatButton
                            android:id="@+id/main_proxy_toggle"
                            style="@style/GhostButton"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:layout_marginLeft="8dp"
                            android:minWidth="0dp"
                            android:minHeight="0dp"
                            android:text="start" />
                    </LinearLayout>

                    <!-- Visibility toggled by MainActivity: shown only when mode=Custom -->
                    <LinearLayout
                        android:id="@+id/main_proxy_url_wrap"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:layout_marginTop="12dp">

                        <TextView
                            style="@style/SectionHeader"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="custom url" />

                        <EditText
                            android:id="@+id/main_proxy_url"
                            style="@style/TerminalInput"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:hint="http://your-proxy/?reqdata="
                            android:inputType="textUri"
                            android:maxLines="1" />
                    </LinearLayout>

                </LinearLayout>

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>
</ScrollView>
